{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(IncidenteId = upper(trim(IncidenteId)),",
				"          TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = upper(trim(Severidad)),",
				"          Descripcion = trim(Descripcion)) ~> derivedColumn1",
				"derivedColumn1 derive(FechaHoraInicio = toTimestamp(concat(iif(instr(FechaHoraInicio, '/') > 0, toString(toDate(FechaHoraInicio, 'dd/MM/yyyy')), FechaHoraInicio), ' ', trim(FechaHoraInicio)), 'yyyy-MM-dd HH:mm'),",
				"          FechaHoraFin = toTimestamp(concat(iif(instr(FechaHoraFin, '/') > 0, toString(toDate(FechaHoraFin, 'dd/MM/yyyy')), FechaHoraFin), ' ', trim(FechaHoraFin)), 'yyyy-MM-dd HH:mm'),",
				"          FechaHoraRegistro = toTimestamp(concat(iif(instr(FechaHoraRegistro, '/') > 0, toString(toDate(FechaHoraRegistro, 'dd/MM/yyyy')), FechaHoraRegistro), ' 00:00'), 'yyyy-MM-dd HH:mm')) ~> derivedColumn2",
				"derivedColumn2 derive(VehiculoId = iif(isNull(VehiculoId) || length(trim(VehiculoId)) == 0, toString(null()), iif(startsWith(VehiculoId, 'V-'), upper(trim(VehiculoId)), concat('V-', trim(VehiculoId))))) ~> derivedColumn3",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}